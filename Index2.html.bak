<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mrudula Store.in - Premium Electronics & Tech</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              dark: '#0f0c1b',
              deep: '#1e1b2e',
              purple: '#7b2cbf',
              teal: '#00d2b5',
              tealDark: '#00b39b',
              accent: '#ff2a75'
            }
          }
        }
      }
    }
  </script>

  <!-- Phosphor Icons & Google Fonts -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0f0c1b; }
    ::-webkit-scrollbar-thumb { background: #332d4f; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #7b2cbf; }
    .glass-card {
      background: rgba(30, 27, 46, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .neon-border:focus-within, .neon-border-active {
      border-color: #00d2b5;
      box-shadow: 0 0 15px rgba(0, 210, 181, 0.25);
    }
  </style>
</head>
<body class="min-h-full flex flex-col bg-[#0f0c1b] text-slate-100">

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>

  <!-- MAIN APP CONTAINER -->
  <div id="app" class="flex-1 flex flex-col min-h-screen">
    
    <!-- Top Announcement & Pincode Bar -->
    <header class="bg-[#151226] border-b border-white/10 text-xs sm:text-sm py-2 px-4 sticky top-0 z-30 shadow-lg backdrop-blur-md bg-opacity-95">
      <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
        
        <!-- Pincode Location Selector Widget -->
        <div class="flex items-center gap-2 text-slate-300 bg-[#25203b] px-3 py-1.5 rounded-full border border-slate-700/60 hover:border-brand-teal transition-all">
          <i class="ph-bold ph-map-pin text-brand-teal text-base animate-bounce"></i>
          <span class="text-xs text-slate-400 hidden sm:inline">Deliver to:</span>
          <div class="flex items-center gap-2">
            <span id="current-pincode-display" class="font-bold text-white tracking-wide">500001</span>
            <span id="current-area-display" class="text-brand-teal font-medium text-xs max-w-[150px] sm:max-w-[220px] truncate">Hyderabad, Telangana</span>
          </div>
          <button onclick="openPincodeModal()" class="ml-1 text-xs text-brand-purple hover:text-brand-teal underline transition-colors font-semibold">
            Change
          </button>
        </div>

        <div class="flex items-center gap-4 text-xs text-slate-300">
          <span class="hidden md:flex items-center gap-1.5 text-emerald-400">
            <i class="ph-bold ph-truck text-sm"></i> Express Delivery across 19,000+ Pin Codes
          </span>
          <button onclick="openReturnPolicyModal()" class="hover:text-brand-teal flex items-center gap-1 transition-colors">
            <i class="ph-bold ph-arrow-counter-clockwise"></i> 7-Day Easy Return Policy
          </button>
        </div>

      </div>
    </header>

    <!-- Main Navigation Header -->
    <nav class="bg-brand-deep/90 border-b border-white/10 py-3.5 px-4 sticky top-[41px] z-20 backdrop-blur-md">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
        
        <!-- Brand Logo -->
        <a href="#" onclick="filterCategory('All')" class="flex items-center gap-2 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-purple to-brand-teal flex items-center justify-center text-white text-xl font-black shadow-lg shadow-brand-purple/30 group-hover:scale-105 transition-transform">
            M
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-xl tracking-tight bg-gradient-to-r from-white via-slate-100 to-brand-teal bg-clip-text text-transparent">
              Mrudula<span class="text-brand-teal">Store.in</span>
            </span>
            <span class="text-[9px] text-slate-400 font-medium tracking-widest uppercase -mt-1">India's Tech Hub</span>
          </div>
        </a>

        <!-- Search Bar with Live Recommendations -->
        <div class="relative flex-1 max-w-xl mx-2 hidden sm:block">
          <div class="relative flex items-center">
            <input id="search-input" type="text" placeholder="Search laptops, smartphones, noise-canceling headphones..." 
              oninput="handleSearchInput(event)" onfocus="showSearchDropdown()"
              class="w-full bg-[#120f24] text-white pl-10 pr-10 py-2.5 rounded-full border border-slate-700 focus:outline-none focus:border-brand-teal text-sm transition-all shadow-inner">
            <i class="ph-bold ph-magnifying-glass absolute left-3.5 text-slate-400 text-base"></i>
            <button id="clear-search-btn" onclick="clearSearch()" class="hidden absolute right-3 text-slate-400 hover:text-white">
              <i class="ph-bold ph-x-circle text-base"></i>
            </button>
          </div>

          <!-- Live Search Dropdown -->
          <div id="search-dropdown" class="hidden absolute top-full left-0 right-0 mt-2 bg-[#1a162b] border border-slate-700/80 rounded-2xl shadow-2xl z-50 overflow-hidden max-h-80 overflow-y-auto divide-y divide-slate-800">
          </div>
        </div>

        <!-- Navigation Buttons & User Profile -->
        <div class="flex items-center gap-2 sm:gap-4">
          
          <!-- Wishlist Button -->
          <button onclick="handleWishlistClick()" class="relative p-2.5 rounded-full hover:bg-slate-800/60 text-slate-300 hover:text-white transition-all">
            <i class="ph-bold ph-heart text-xl"></i>
            <span id="wishlist-badge" class="hidden absolute -top-1 -right-1 bg-brand-accent text-white font-bold text-[10px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-[#1e1b2e]">
              0
            </span>
          </button>

          <!-- Cart Button -->
          <button onclick="toggleCartDrawer()" class="relative p-2.5 rounded-full bg-gradient-to-r from-brand-purple/20 to-brand-teal/20 border border-brand-teal/40 hover:border-brand-teal text-white transition-all flex items-center gap-2 px-4">
            <i class="ph-bold ph-shopping-bag text-xl text-brand-teal"></i>
            <span class="text-xs font-semibold hidden md:inline">Cart</span>
            <span id="cart-count-badge" class="bg-brand-teal text-slate-950 font-extrabold text-xs px-2 py-0.5 rounded-full">
              0
            </span>
          </button>

          <!-- User Authentication Dropdown/Button -->
          <div id="auth-section" class="relative">
            <!-- Will be dynamically populated by JS (Login button OR User Profile Menu) -->
          </div>

        </div>
      </div>

      <!-- Mobile Search Bar -->
      <div class="mt-3 sm:hidden relative">
        <input id="mobile-search-input" type="text" placeholder="Search gadgets..." 
          oninput="handleSearchInput(event)"
          class="w-full bg-[#120f24] text-white pl-9 pr-8 py-2 rounded-lg border border-slate-700 focus:outline-none focus:border-brand-teal text-xs">
        <i class="ph-bold ph-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-sm"></i>
      </div>
    </nav>

    <!-- Category Pills Bar -->
    <section class="bg-[#131022] border-b border-white/5 py-2.5 px-4 overflow-x-auto no-scrollbar">
      <div class="max-w-7xl mx-auto flex items-center gap-2 min-w-max">
        <button onclick="filterCategory('All')" class="cat-pill active-cat text-xs px-4 py-1.5 rounded-full font-medium transition-all bg-brand-purple text-white shadow-md">
          <i class="ph-bold ph-[#squares-four] mr-1"></i> All Products
        </button>
        <button onclick="filterCategory('Mobiles')" class="cat-pill text-xs px-4 py-1.5 rounded-full font-medium text-slate-300 hover:bg-slate-800 transition-all">
          <i class="ph-bold ph-device-mobile mr-1"></i> Mobiles
        </button>
        <button onclick="filterCategory('Laptops')" class="cat-pill text-xs px-4 py-1.5 rounded-full font-medium text-slate-300 hover:bg-slate-800 transition-all">
          <i class="ph-bold ph-laptop mr-1"></i> Laptops
        </button>
        <button onclick="filterCategory('Audio')" class="cat-pill text-xs px-4 py-1.5 rounded-full font-medium text-slate-300 hover:bg-slate-800 transition-all">
          <i class="ph-bold ph-headphones mr-1"></i> Audio
        </button>
        <button onclick="filterCategory('Wearables')" class="cat-pill text-xs px-4 py-1.5 rounded-full font-medium text-slate-300 hover:bg-slate-800 transition-all">
          <i class="ph-bold ph-watch mr-1"></i> Wearables
        </button>
        <button onclick="filterCategory('Gaming')" class="cat-pill text-xs px-4 py-1.5 rounded-full font-medium text-slate-300 hover:bg-slate-800 transition-all">
          <i class="ph-bold ph-game-controller mr-1"></i> Gaming
        </button>
        <button onclick="filterCategory('Accessories')" class="cat-pill text-xs px-4 py-1.5 rounded-full font-medium text-slate-300 hover:bg-slate-800 transition-all">
          <i class="ph-bold ph-plug-charging mr-1"></i> Accessories
        </button>
      </div>
    </section>

    <!-- Hero Promotional Banner -->
    <section class="max-w-7xl mx-auto px-4 pt-6 w-full">
      <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-brand-deep via-purple-950 to-brand-deep border border-brand-purple/30 p-6 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6 shadow-2xl">
        <div class="z-10 max-w-xl text-center md:text-left">
          <span class="inline-flex items-center gap-1.5 bg-brand-teal/10 text-brand-teal font-semibold text-xs px-3 py-1 rounded-full border border-brand-teal/30 mb-3">
            <i class="ph-bold ph-sparkle"></i> Festival Electronics Sale 2026
          </span>
          <h1 class="text-2xl sm:text-4xl font-black text-white leading-tight">
            Next-Gen Tech, <br class="hidden sm:inline"><span class="bg-gradient-to-r from-brand-teal via-purple-300 to-pink-500 bg-clip-text text-transparent">Delivered to Your Doorstep</span>
          </h1>
          <p class="text-slate-300 text-xs sm:text-sm mt-2.5 leading-relaxed">
            Instant pincode verification, verified buyers reviews, same-day dispatch & 100% genuine Indian warranty on top brands.
          </p>
          <div class="mt-5 flex flex-wrap gap-3 justify-center md:justify-start">
            <a href="#product-grid" class="bg-gradient-to-r from-brand-purple to-purple-700 hover:from-purple-600 hover:to-brand-purple text-white font-bold text-xs sm:text-sm px-6 py-2.5 rounded-xl shadow-lg transition-all flex items-center gap-2">
              Explore Deals <i class="ph-bold ph-arrow-right"></i>
            </a>
            <button onclick="openPincodeModal()" class="bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-600 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-xl transition-all flex items-center gap-1.5">
              <i class="ph-bold ph-map-pin-line text-brand-teal"></i> Check Pincode Coverage
            </button>
          </div>
        </div>
        
        <div class="relative w-full md:w-auto flex justify-center">
          <div class="w-56 h-56 sm:w-64 sm:h-64 rounded-2xl bg-gradient-to-tr from-brand-purple/40 to-brand-teal/20 p-2 border border-white/10 flex items-center justify-center relative shadow-2xl rotate-1 hover:rotate-0 transition-transform">
            <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80" alt="Tech Banner" class="w-full h-full object-cover rounded-xl">
            <div class="absolute -bottom-3 -left-3 bg-[#1e1b2e] border border-brand-teal/50 rounded-xl p-2.5 shadow-xl flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">
                ✓
              </div>
              <div>
                <p class="text-[10px] text-slate-400 font-medium">Fast Pincode Delivery</p>
                <p id="hero-pincode-est" class="text-xs font-bold text-white">2-4 Days Guaranteed</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MAIN PRODUCT SECTION -->
    <main class="max-w-7xl mx-auto px-4 py-8 flex-1 w-full">
      
      <!-- Section Header & Filter Controls -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 id="section-title" class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
            Trending Electronics
          </h2>
          <p id="section-subtitle" class="text-slate-400 text-xs">
            Showing all items with instant delivery status to <span id="active-pincode-sub" class="text-brand-teal font-semibold">500001</span>
          </p>
        </div>

        <!-- Sort dropdown -->
        <div class="flex items-center gap-2 text-xs text-slate-300">
          <label for="sort-select" class="whitespace-nowrap font-medium text-slate-400">Sort By:</label>
          <select id="sort-select" onchange="handleSortChange(event)" class="bg-[#1a162b] text-white border border-slate-700 rounded-lg px-3 py-1.5 focus:outline-none focus:border-brand-teal">
            <option value="featured">Featured</option>
            <option value="low-high">Price: Low to High</option>
            <option value="high-low">Price: High to Low</option>
            <option value="rating">Customer Rating</option>
          </select>
        </div>
      </div>

      <!-- Product Cards Grid -->
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
        <!-- JS Dynamically Populates Cards -->
      </div>

      <!-- Empty State -->
      <div id="empty-products" class="hidden text-center py-16 bg-[#161226] rounded-3xl border border-dashed border-slate-700 p-8">
        <i class="ph-bold ph-magnifying-glass text-4xl text-slate-500 mb-3"></i>
        <h3 class="text-lg font-bold text-white">No products found</h3>
        <p class="text-xs text-slate-400 mt-1">Try clearing search terms or selecting a different category.</p>
        <button onclick="filterCategory('All')" class="mt-4 text-xs bg-brand-purple hover:bg-purple-600 text-white font-semibold px-4 py-2 rounded-lg transition-colors">
          Show All Products
        </button>
      </div>

    </main>

    <!-- FOOTER -->
    <footer class="bg-[#120e24] border-t border-white/10 pt-10 pb-6 px-4 text-slate-400 text-xs mt-auto">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        <div>
          <span class="font-bold text-lg text-white tracking-tight">Mrudula<span class="text-brand-teal">Store.in</span></span>
          <p class="mt-2 text-slate-400 leading-relaxed">
            India's ultimate destination for tech gadgets, gaming setups, and official brand electronics with nationwide verified postal coverage.
          </p>
        </div>
        <div>
          <h4 class="font-bold text-white text-sm mb-3">Customer Care</h4>
          <ul class="space-y-2">
            <li><button onclick="openReturnPolicyModal()" class="hover:text-brand-teal transition-colors">7-Day Return & Refund</button></li>
            <li><button onclick="openPincodeModal()" class="hover:text-brand-teal transition-colors">Check Serviceable Pincodes</button></li>
            <li><button onclick="handleProtectedAction(() => openOrdersModal())" class="hover:text-brand-teal transition-colors">Track Your Order</button></li>
            <li><a href="#" class="hover:text-brand-teal transition-colors">Warranty Registration</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-white text-sm mb-3">Popular Categories</h4>
          <ul class="space-y-2">
            <li><button onclick="filterCategory('Mobiles')" class="hover:text-brand-teal transition-colors">5G Smartphones</button></li>
            <li><button onclick="filterCategory('Laptops')" class="hover:text-brand-teal transition-colors">Gaming Laptops</button></li>
            <li><button onclick="filterCategory('Audio')" class="hover:text-brand-teal transition-colors">Wireless Earbuds</button></li>
            <li><button onclick="filterCategory('Wearables')" class="hover:text-brand-teal transition-colors">Smartwatches</button></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-white text-sm mb-3">100% Safe Payments</h4>
          <p class="mb-3">Accepting all Indian payment methods:</p>
          <div class="flex flex-wrap gap-2 text-slate-200">
            <span class="bg-[#1e1b2e] px-2.5 py-1 rounded border border-slate-700 text-[10px] font-bold">UPI / GPay / PhonePe</span>
            <span class="bg-[#1e1b2e] px-2.5 py-1 rounded border border-slate-700 text-[10px] font-bold">Rupay / Visa Cards</span>
            <span class="bg-[#1e1b2e] px-2.5 py-1 rounded border border-slate-700 text-[10px] font-bold">Cash on Delivery</span>
          </div>
        </div>
      </div>
      <div class="max-w-7xl mx-auto border-t border-slate-800 pt-4 flex flex-col sm:flex-row items-center justify-between text-[11px] gap-2">
        <p>© 2026 MrudulaStore.in — All Rights Reserved. Integrated with Indian Post API & Firebase Realtime Store.</p>
        <p class="text-slate-500">Built for speed, security & seamless shopping across India.</p>
      </div>
    </footer>

  </div>

  <!-- MODAL: PINCODE SELECTOR & AREA LOOKUP -->
  <div id="pincode-modal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#1a162b] border border-slate-700 rounded-3xl max-w-md w-full p-6 shadow-2xl relative animate-in fade-in zoom-in duration-200">
      <button onclick="closePincodeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2">
        <i class="ph-bold ph-x text-lg"></i>
      </button>

      <div class="flex items-center gap-3 mb-4">
        <div class="w-12 h-12 rounded-2xl bg-brand-teal/10 border border-brand-teal/30 text-brand-teal flex items-center justify-center text-2xl">
          <i class="ph-bold ph-map-pin-line"></i>
        </div>
        <div>
          <h3 class="text-lg font-bold text-white">Select Delivery Location</h3>
          <p class="text-xs text-slate-400">Enter your 6-digit Indian PIN code to check exact delivery estimates</p>
        </div>
      </div>

      <div class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Enter Postal Pincode</label>
          <div class="relative flex items-center">
            <input id="modal-pincode-input" type="text" maxlength="6" placeholder="e.g. 500001, 110001, 400001" 
              class="w-full bg-[#100d21] text-white px-4 py-3 rounded-xl border border-slate-700 focus:outline-none focus:border-brand-teal text-base font-mono tracking-widest uppercase">
            <button onclick="checkPincodeFromModal()" class="absolute right-2 bg-gradient-to-r from-brand-purple to-purple-600 hover:from-purple-600 hover:to-brand-purple text-white text-xs font-bold px-4 py-2 rounded-lg transition-all">
              Verify
            </button>
          </div>
          <p id="pincode-modal-status" class="text-xs mt-2 font-medium min-h-[1.25rem]"></p>
        </div>

        <!-- Detected Area Result Card -->
        <div id="modal-pincode-result" class="hidden bg-[#221c38] p-3.5 rounded-2xl border border-slate-700">
          <div class="flex items-center gap-2 text-emerald-400 text-xs font-bold mb-1">
            <i class="ph-bold ph-check-circle text-base"></i> Serviceable Location Identified
          </div>
          <p id="modal-detected-area" class="text-sm font-bold text-white">Guntur, Andhra Pradesh</p>
          <p id="modal-detected-delivery" class="text-xs text-brand-teal mt-1">Est. Delivery: Wednesday, Oct 7</p>
        </div>

        <div class="border-t border-slate-800 pt-3">
          <p class="text-[11px] text-slate-400 font-medium mb-2">Try quick sample pincodes:</p>
          <div class="flex flex-wrap gap-1.5">
            <button onclick="setQuickPincode('500001')" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-2.5 py-1 rounded-lg">500001 (Hyd)</button>
            <button onclick="setQuickPincode('110001')" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-2.5 py-1 rounded-lg">110001 (Delhi)</button>
            <button onclick="setQuickPincode('400001')" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-2.5 py-1 rounded-lg">400001 (Mumbai)</button>
            <button onclick="setQuickPincode('560001')" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-2.5 py-1 rounded-lg">560001 (Blr)</button>
            <button onclick="setQuickPincode('522001')" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-2.5 py-1 rounded-lg">522001 (Guntur)</button>
          </div>
        </div>

        <button onclick="applyPincodeSelection()" id="apply-pincode-btn" class="w-full bg-brand-teal hover:bg-brand-tealDark text-slate-950 font-bold text-sm py-3 rounded-xl transition-all shadow-lg shadow-brand-teal/20">
          Apply & Save Location
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL: AUTHENTICATION (LOGIN / REGISTER) -->
  <div id="auth-modal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="bg-[#1a162b] border border-slate-700 rounded-3xl max-w-md w-full p-6 shadow-2xl relative">
      <button onclick="closeAuthModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2">
        <i class="ph-bold ph-x text-lg"></i>
      </button>

      <!-- Tabs Header -->
      <div class="flex border-b border-slate-700 mb-6">
        <button id="tab-login-btn" onclick="switchAuthTab('login')" class="flex-1 py-2.5 text-center font-bold text-sm border-b-2 border-brand-teal text-brand-teal transition-all">
          Sign In
        </button>
        <button id="tab-register-btn" onclick="switchAuthTab('register')" class="flex-1 py-2.5 text-center font-bold text-sm text-slate-400 hover:text-slate-200 transition-all">
          Create Account
        </button>
      </div>

      <!-- Login Form -->
      <form id="login-form" onsubmit="handleLoginSubmit(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Email Address</label>
          <input id="login-email" type="email" required placeholder="name@example.com" 
            class="w-full bg-[#100d21] text-white px-4 py-2.5 rounded-xl border border-slate-700 focus:outline-none focus:border-brand-teal text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Password</label>
          <input id="login-password" type="password" required placeholder="••••••••" 
            class="w-full bg-[#100d21] text-white px-4 py-2.5 rounded-xl border border-slate-700 focus:outline-none focus:border-brand-teal text-sm">
        </div>
        <button type="submit" id="login-submit-btn" class="w-full bg-gradient-to-r from-brand-purple to-purple-600 hover:from-purple-600 hover:to-brand-purple text-white font-bold py-3 rounded-xl shadow-lg transition-all text-sm mt-2">
          Sign In to MrudulaStore
        </button>
      </form>

      <!-- Registration Form -->
      <form id="register-form" onsubmit="handleRegisterSubmit(event)" class="hidden space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Full Name</label>
          <input id="reg-name" type="text" required placeholder="e.g. Mrudula Sharma" 
            class="w-full bg-[#100d21] text-white px-4 py-2 rounded-xl border border-slate-700 focus:outline-none focus:border-brand-teal text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Email Address</label>
          <input id="reg-email" type="email" required placeholder="name@example.com" 
            class="w-full bg-[#100d21] text-white px-4 py-2 rounded-xl border border-slate-700 focus:outline-none focus:border-brand-teal text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Mobile Number (India +91)</label>
          <input id="reg-phone" type="tel" required placeholder="9876543210" maxlength="10" 
            class="w-full bg-[#100d21] text-white px-4 py-2 rounded-xl border border-slate-700 focus:outline-none focus:border-brand-teal text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Password</label>
          <input id="reg-password" type="password" required minlength="6" placeholder="At least 6 characters" 
            class="w-full bg-[#100d21] text-white px-4 py-2 rounded-xl border border-slate-700 focus:outline-none focus:border-brand-teal text-sm">
        </div>
        <button type="submit" id="register-submit-btn" class="w-full bg-brand-teal hover:bg-brand-tealDark text-slate-950 font-bold py-3 rounded-xl shadow-lg transition-all text-sm mt-2">
          Register & Create Database Profile
        </button>
      </form>

      <p class="text-[11px] text-slate-400 text-center mt-4">
        🔒 Secured by Firebase Auth & Firestore DB Encryption
      </p>
    </div>
  </div>

  <!-- MODAL: PRODUCT DETAIL & REVIEWS MODAL -->
  <div id="product-detail-modal" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto">
